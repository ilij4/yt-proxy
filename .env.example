NODE_ENV=development
LOG_LEVEL=info
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/yt_proxy
YOUTUBE_API_BASE_URL=https://www.googleapis.com/youtube/v3
YOUTUBE_API_KEY=replace_with_your_youtube_api_key
METADATA_REFRESH_ENABLED=true
METADATA_REFRESH_INTERVAL_MS=60000
METADATA_REFRESH_MAX_VIDEOS_PER_RUN=200
METADATA_REFRESH_CONCURRENCY=5
